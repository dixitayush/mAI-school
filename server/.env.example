PORT=5001
NODE_ENV=development

# Docker Postgres (docker compose -f ../docker-compose.dev.yml up -d)
# VPS compose overrides host to `db` — do not use Neon / cloud URLs.
DATABASE_URL=postgres://maischool:change-me@localhost:5433/mai_school

MAI_GRAPHQL_DB_USER=mai_graphql
MAI_GRAPHQL_DB_PASSWORD=change-me

PG_POOL_MAX=8
PG_GRAPHQL_POOL_MAX=8

JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_AUDIENCE=postgraphile
JWT_ISSUER=mai-school
JWT_EXPIRES_IN=12h

CORS_ORIGINS=http://localhost:3000
ROOT_DOMAIN=localhost
PUBLIC_API_URL=http://localhost:5001

BILLING_INR_PER_STUDENT_MONTH=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SMTP_FROM="mAI-school <noreply@maischool.ayushdixit.work>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
