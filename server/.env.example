PORT=5001
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mai_school
# Neon / PgBouncer pooler URL for runtime traffic (preferred in production).
# Keep DATABASE_URL as the direct endpoint for owner/watch/migrations.
# DATABASE_POOL_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/mai_school?sslmode=require
# Optional RLS GraphQL role (created by initDb)
# GRAPHQL_DATABASE_URL=
# GRAPHQL_DATABASE_POOL_URL=
# MAI_GRAPHQL_DB_USER=mai_graphql
# MAI_GRAPHQL_DB_PASSWORD=change_me_in_production
# SKIP_GRAPHQL_RLS=false

# Connection pools (Neon-safe defaults; raise for local Postgres)
# PG_POOL_MAX=8
# PG_GRAPHQL_POOL_MAX=8
# PG_IDLE_TIMEOUT_MS=10000
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_SSL_REJECT_UNAUTHORIZED=1

# JWT access tokens (REQUIRED in production: ≥32 random characters)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_AUDIENCE=postgraphile
JWT_ISSUER=mai-school
JWT_EXPIRES_IN=12h

# CORS — browser origins only (scheme + host + port). No paths, no trailing slash.
# Netlify path tenants (/i/demo, /i/other) share ONE origin — do not list each school.
#   CORS_ORIGINS=https://mai-school.netlify.app,http://localhost:3000
# Real DNS subdomains later (demo.yourdomain.com):
#   CORS_ORIGINS=https://yourdomain.com,https://*.yourdomain.com
# Listing http://localhost:3000 also allows http://*.localhost:3000
# CLIENT_ORIGIN=http://localhost:3000

# Public URL of this API (used when building file URLs)
# PUBLIC_API_URL=https://api.yourdomain.com

# Rate limits (keyed by tenant + IP)
# AUTH_RATE_LIMIT_MAX=30
# API_RATE_LIMIT_MAX=200
# GRAPHQL_RATE_LIMIT_MAX=120
# JSON_BODY_LIMIT=1mb

# GraphQL / GraphiQL (GraphiQL is off when NODE_ENV=production)
# ENABLE_GRAPHIQL=0
# REQUIRE_GRAPHQL_AUTH=1

# Multi-tenant host
ROOT_DOMAIN=localhost

# Billing (INR per student per month)
BILLING_INR_PER_STUDENT_MONTH=30

# Google Gemini (AI attendance OCR + chatbot)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# SMTP (welcome / attendance emails)
# SMTP_FROM="mAI-school <noreply@yourdomain.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password

# Twilio (optional SMS / WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number

# Behind a reverse proxy (Render, nginx, etc.)
# TRUST_PROXY=1
