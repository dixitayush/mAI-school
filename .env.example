# VPS deploy: from repo root run ../setup.sh once, then ./deploy.sh here.
# See ../DEPLOYMENT.md. Traefik terminates TLS; Caddy is private.
# Local laptop: docker compose -f docker-compose.dev.yml up -d

MAISCHOOL_HOST=maischool.ayushdixit.work
PUBLIC_API_URL=https://maischool.ayushdixit.work
CORS_ORIGINS=https://maischool.ayushdixit.work

# Docker Postgres — laptop publishes 5433; VPS compose rewrites host to `db`
POSTGRES_USER=maischool
POSTGRES_DB=mai_school
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://maischool:change-me@localhost:5433/mai_school

JWT_SECRET=
JWT_AUDIENCE=postgraphile
JWT_ISSUER=mai-school
JWT_EXPIRES_IN=12h

MAI_GRAPHQL_DB_USER=mai_graphql
MAI_GRAPHQL_DB_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SMTP_FROM="mAI-school <noreply@maischool.ayushdixit.work>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
