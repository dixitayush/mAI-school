# VPS deploy: from repo root run ../setup.sh once, then ./deploy.sh here.
# See ../DEPLOYMENT.md. Traefik terminates TLS; Caddy is private.
# Local laptop: docker compose -f docker-compose.dev.yml up -d

MAISCHOOL_HOST=maischool.ayushdixit.work
PUBLIC_API_URL=https://maischool.ayushdixit.work
CORS_ORIGINS=https://maischool.ayushdixit.work

# Docker Postgres — laptop publishes 5433; VPS compose rewrites host to `db`
POSTGRES_USER=maischool
POSTGRES_DB=mai_school
POSTGRES_PASSWORD=mai_school
DATABASE_URL=postgres://maischool:change-me@localhost:5433/mai_school

# --- Authentication / JWT ---
JWT_SECRET=
JWT_AUDIENCE=postgraphile
JWT_ISSUER=mai-school
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Legacy fallback (used if JWT_ACCESS_EXPIRES_IN is not set)
# JWT_EXPIRES_IN=12h

# --- PostGraphile ---
MAI_GRAPHQL_DB_USER=mai_graphql
MAI_GRAPHQL_DB_PASSWORD=
# SKIP_GRAPHQL_RLS=1
# REQUIRE_GRAPHQL_AUTH=1
# ENABLE_GRAPHIQL=1

# --- AI: OpenAI (preferred) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
AI_ENABLED=true
AI_DAILY_TENANT_LIMIT=1000
AI_DAILY_USER_LIMIT=100

# --- AI: Gemini (fallback when OpenAI is not set) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email: Resend (preferred) ---
RESEND_API_KEY=
RESEND_FROM=mAI-school <noreply@maischool.ayushdixit.work>
RESEND_WEBHOOK_SECRET=

# --- Email: SMTP (fallback when Resend is not set) ---
SMTP_FROM="mAI-school <noreply@maischool.ayushdixit.work>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Background Jobs ---
JOB_POLL_INTERVAL_MS=5000
JOB_CONCURRENCY=3

# --- Server ---
PORT=5001
NODE_ENV=development
TRUST_PROXY=0
JSON_BODY_LIMIT=1mb

# --- Connection Pooling ---
PG_POOL_MAX=8
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECTION_TIMEOUT_MS=5000

# --- Storage (for file uploads — future S3-compatible) ---
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Observability ---
LOG_LEVEL=info
# SENTRY_DSN=

# --- Rate Limiting ---
# AUTH_RATE_LIMIT_MAX=30
# API_RATE_LIMIT_MAX=200
# GRAPHQL_RATE_LIMIT_MAX=120

# --- Feature Flags (default: all enabled) ---
# ENABLE_PARENT_PORTAL=true
# ENABLE_AI_TUTOR=true
# ENABLE_AI_TEACHER_STUDIO=true
# ENABLE_AI_PRINCIPAL_INSIGHTS=true
# ENABLE_ADMISSIONS=true
# ENABLE_TRANSPORT=true
# ENABLE_LIBRARY=true
# ENABLE_WORKFLOWS=true
